# ------------------------------------------------------------
# Public Supabase configuration (client-side).
#
# Copy this file to `.env.local` and fill in the values from
# Supabase Dashboard → Project Settings → API Keys.
#
# Only the PUBLISHABLE key belongs here. Never add a secret or
# service-role key: every VITE_ variable is bundled into the
# public website.
# ------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
